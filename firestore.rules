rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Estar en userRoles equivale a ser miembro aprobado de la comunidad.
    // Una cuenta de Google recién creada, por sí sola, no supera este
    // filtro — solo lo hace vía el alta automática (Cloud Function
    // syncUserRoleOnUserWrite) o una asignación hecha por un administrador.
    function isMiembro() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    function myRoleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isMiembro() && myRoleDoc().role == role;
    }

    // ---------- Multi-iglesia ----------
    // A qué iglesia pertenece quien llama, según su propio userRoles (que la
    // Cloud Function syncUserRoleOnUserWrite mantiene igual que el church_id
    // guardado en su documento de "users").
    function myChurchId() {
      return myRoleDoc().church_id;
    }

    function isStaff() {
      return hasRole('admin') || hasRole('controller');
    }

    // Líder de CUALQUIER ministerio (member_type == 'Líder' en su ficha de
    // miembro) — no depende del rol de la cuenta, así un asistente que
    // lidera un grupo puede crear eventos sin necesitar ser admin/controlador.
    function isMinistryLeader() {
      return isMiembro() && myRoleDoc().member_id != null
        && get(/databases/$(database)/documents/members/$(myRoleDoc().member_id)).data.member_type == 'Líder';
    }

    // ---------- Buena Tierra (clases de niños) ----------
    function isBuenaTierraTeacherOf(classId) {
      return isMiembro() && exists(/databases/$(database)/documents/buenaTierraClasses/$(classId)) && (
        myRoleDoc().member_id in get(/databases/$(database)/documents/buenaTierraClasses/$(classId)).data.teacher_ids ||
        myRoleDoc().member_id in get(/databases/$(database)/documents/buenaTierraClasses/$(classId)).data.helper_ids
      );
    }

    function isBuenaTierraLeader() {
      return isMiembro() && exists(/databases/$(database)/documents/buenaTierraSettings/main)
        && myRoleDoc().member_id == get(/databases/$(database)/documents/buenaTierraSettings/main).data.leader_member_id;
    }

    // ---------- Líder asignado por ministerio (Jóvenes, Damas, etc.) ----------
    // Guardado por el campo booleano del grupo (ej. 'grupo_jovenes'), que es
    // la misma clave que ya usa el scope_key de ofrenda ('grupo:<campo>') —
    // así ambas cosas comparten un único lugar de verdad. Es aditivo al
    // criterio anterior (member_type == 'Líder' + estar en el grupo): un
    // administrador puede además asignar explícitamente al líder de un
    // ministerio en particular.
    function isAssignedGroupLeader(field) {
      return isMiembro() && exists(/databases/$(database)/documents/groupSettings/$(field))
        && myRoleDoc().member_id == get(/databases/$(database)/documents/groupSettings/$(field)).data.leader_member_id;
    }

    function isGroupLeader(field) {
      return isMiembro() && myRoleDoc().member_id != null && (
        (get(/databases/$(database)/documents/members/$(myRoleDoc().member_id)).data.member_type == 'Líder'
          && get(/databases/$(database)/documents/members/$(myRoleDoc().member_id)).data[field] == true)
        || isAssignedGroupLeader(field)
      );
    }

    // ---------- Matriz de permisos (editable por el admin desde Usuarios) ----------
    // Solo cubre los permisos que NO son un límite de seguridad fijo (ver el
    // comentario en src/pages/admin/UsersPage.jsx sobre cuáles quedan
    // bloqueadas). Admin siempre los tiene, Asistente nunca — este documento
    // solo decide si Controlador/Tesorero/Bienvenida también los tienen.
    function hasDynamicPermission(permissionKey) {
      return isMiembro() && exists(/databases/$(database)/documents/settings/rolePermissions)
        && get(/databases/$(database)/documents/settings/rolePermissions).data.get(permissionKey, {}).get(myRoleDoc().role, false) == true;
    }

    // ---------- Ofrenda de ministerio (registro interno de cada líder) ----------
    // scopeKey: 'grupo:<campo>' (Jóvenes/Damas/etc, el campo booleano del
    // miembro en OPERATIONAL_GROUPS), o 'buena-tierra:<classId>'. Escuela del
    // Discípulo no tiene líder propio todavía, así que su ofrenda queda
    // reservada a isStaff() (ver más abajo, cubierto sin entrar a esta función).
    function canManageMinistryOffering(scopeKey) {
      return isStaff() || (
        (scopeKey.split(':')[0] == 'grupo' && isGroupLeader(scopeKey.split(':')[1])) ||
        (scopeKey.split(':')[0] == 'buena-tierra' && isBuenaTierraTeacherOf(scopeKey.split(':')[1]))
      );
    }

    // ---------- Finanzas: confidencial, solo Tesorero (ni admin) ----------
    match /offerings/{docId} {
      allow read, write: if hasRole('tesorero');
    }
    match /tithes/{docId} {
      allow read, write: if hasRole('tesorero');
    }

    // ---------- Roles: el cliente nunca escribe esto ----------
    // Se llena únicamente desde el backend (Admin SDK): la función
    // syncUserRoleOnUserWrite lo mantiene sincronizado con el rol guardado
    // en "users" cada vez que ese documento cambia, y setUserRole es el
    // único camino para que un administrador cambie el rol de otra cuenta.
    // Cerrar esto es la corrección del hallazgo crítico del informe de
    // seguridad (autoasignación del rol Tesorero).
    match /userRoles/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Usuarios ----------
    // Los documentos de "users" están indexados por un id interno de la app,
    // no por el uid de Firebase Auth, por lo que la verificación de dueño se
    // hace contra el campo auth_uid guardado en el propio documento.
    match /users/{docId} {
      allow read: if isMiembro() && resource.data.church_id == myChurchId();
      // Alta propia: solo puede crear su propio documento (auth_uid debe
      // coincidir), con rol "attendee" y una iglesia real — cualquier otro
      // rol requiere un administrador (de la MISMA iglesia; el fundador de
      // una iglesia nueva se crea aparte, vía la función createChurch con
      // privilegios de servidor, no por este camino). Un administrador
      // puede además precrear la cuenta de otra persona de su iglesia.
      allow create: if isSignedIn() && (
        (hasRole('admin') && request.resource.data.church_id == myChurchId()) ||
        (request.resource.data.auth_uid == request.auth.uid && request.resource.data.role == 'attendee'
          && exists(/databases/$(database)/documents/churches/$(request.resource.data.church_id)))
      );
      // Actualización propia (latido de conexión, foto, tokens de
      // notificación) o por un administrador de la misma iglesia. Se admite
      // además "reclamar" una cuenta creada antes de que existiera el campo
      // auth_uid, verificando que el correo coincida con el de la sesión.
      allow update: if isSignedIn() && (
        (hasRole('admin') && resource.data.church_id == myChurchId()) ||
        resource.data.get('auth_uid', null) == request.auth.uid ||
        (resource.data.get('auth_uid', null) == null
          && resource.data.get('email', null) == request.auth.token.get('email', null))
      );
      allow delete: if hasRole('admin') && resource.data.church_id == myChurchId();
    }

    // ---------- Miembros ----------
    match /members/{docId} {
      allow read: if isMiembro() && resource.data.church_id == myChurchId();
      // Alta abierta: necesaria para que el registro de una cuenta nueva
      // pueda crear su propio miembro (todavía sin userRoles) — se exige
      // eso sí que la iglesia indicada exista de verdad. La modificación de
      // miembros existentes queda reservada al equipo de esa misma iglesia
      // (admin/controlador), o a quien la matriz de permisos le haya
      // activado "Gestión de miembros".
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/churches/$(request.resource.data.church_id));
      allow update, delete: if isMiembro() && resource.data.church_id == myChurchId()
        && (isStaff() || hasDynamicPermission('manage_members'));
    }

    // ---------- Asistencia ----------
    // Un miembro solo puede registrar SU PROPIA asistencia (el member_id del
    // documento debe coincidir con el que tiene vinculado en userRoles) —
    // así el registro por GPS o código QR no permite marcar presente a
    // nombre de otra persona. El equipo puede registrar a cualquiera de su
    // misma iglesia (registro manual en la puerta, visitantes sin cuenta).
    match /attendances/{docId} {
      allow read: if isMiembro() && resource.data.church_id == myChurchId();
      allow create: if isSignedIn() && request.resource.data.church_id == myChurchId() && (
        isStaff() ||
        request.resource.data.member_id == myRoleDoc().member_id ||
        hasDynamicPermission('register_others_attendance') ||
        // Un maestro/ayudante de Buena Tierra puede registrar la asistencia
        // de los niños de SU clase (no de cualquier miembro).
        (isMiembro()
          && get(/databases/$(database)/documents/members/$(request.resource.data.member_id)).data.get('buena_tierra_class', null) != null
          && isBuenaTierraTeacherOf(get(/databases/$(database)/documents/members/$(request.resource.data.member_id)).data.buena_tierra_class))
      );
      allow update, delete: if isMiembro() && resource.data.church_id == myChurchId() && isStaff();
    }

    // ---------- Avisos (disparan notificaciones push institucionales) ----------
    // Solo un administrador puede crear un aviso, y el campo created_by debe
    // ser su propio uid — la función onGroupNoticeCreated vuelve a
    // verificar esto en el backend antes de enviar cualquier notificación.
    match /groupNotices/{docId} {
      allow read: if isMiembro();
      allow create: if hasRole('admin') && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if hasRole('admin');
    }

    // ---------- Chats en vivo (comunidad y radio) ----------
    // Cualquier miembro puede borrar SU PROPIO mensaje (sender_uid es el uid
    // real de Firebase Auth de quien lo envió, no el id interno de la app);
    // un administrador puede borrar cualquiera, incluida una limpieza total.
    match /generalMessages/{docId} {
      allow read, create: if isMiembro();
      allow delete: if hasRole('admin') || (isMiembro() && resource.data.sender_uid == request.auth.uid);
      allow update: if false;
    }
    match /radioMessages/{docId} {
      allow read, create: if isMiembro();
      allow delete: if hasRole('admin') || (isMiembro() && resource.data.sender_uid == request.auth.uid);
      allow update: if false;
    }

    // ---------- Biblia colaborativa (destacar y comentar) ----------
    match /bibleHighlights/{docId} {
      allow read: if isMiembro();
      allow create: if isMiembro() && request.resource.data.author_uid == request.auth.uid;
      // Cambiar de color es una actualización (setDoc con merge sobre un
      // destacado que ya existía) — solo el propio dueño puede hacerlo.
      allow update: if isMiembro() && resource.data.author_uid == request.auth.uid
        && request.resource.data.author_uid == request.auth.uid;
      allow delete: if isMiembro() && (resource.data.author_uid == request.auth.uid || hasRole('admin'));
    }
    match /bibleComments/{docId} {
      allow read: if isMiembro();
      allow create: if isMiembro() && request.resource.data.author_uid == request.auth.uid;
      allow delete: if isMiembro() && (resource.data.author_uid == request.auth.uid || hasRole('admin'));
      allow update: if false;
    }

    // ---------- Buena Tierra: clases y liderazgo ----------
    // Cambiar rango de edad o asignar maestros/ayudantes: solo admin o quien
    // esté designado como líder principal de Buena Tierra.
    match /buenaTierraClasses/{classId} {
      allow read: if isMiembro();
      // El maestro/ayudante de la clase también puede escribir (tema, cita
      // y rango de edad son contenido semanal suyo, no solo del líder/admin).
      allow write: if hasRole('admin') || isBuenaTierraLeader() || isBuenaTierraTeacherOf(classId);
    }
    match /buenaTierraSettings/{docId} {
      allow read: if isMiembro();
      allow write: if hasRole('admin');
    }
    // Líder asignado por ministerio (Jóvenes, Damas, etc.) — solo un admin
    // puede asignarlo/cambiarlo.
    match /groupSettings/{field} {
      allow read: if isMiembro();
      allow write: if hasRole('admin');
    }

    // ---------- Refugios (grupos pequeños / células) ----------
    // Mismo criterio que la página (RefugiosPage.jsx): solo admin/controlador
    // gestionan los refugios y quién está inscrito en cuál.
    match /refugios/{docId} {
      allow read: if isMiembro();
      allow write: if isStaff();
    }
    match /refugioEnrollments/{memberId} {
      allow read: if isMiembro();
      allow write: if isStaff();
    }

    // ---------- Ofrenda de ministerio (registro interno, no confidencial) ----------
    match /ministryOfferings/{docId} {
      allow read: if isMiembro();
      allow create: if isMiembro() && canManageMinistryOffering(request.resource.data.scope_key);
      allow delete: if isMiembro() && canManageMinistryOffering(resource.data.scope_key);
      allow update: if false;
    }

    // ---------- Eventos (incluye cadenas de oración/ayuno) ----------
    // Crear un evento: staff o líder de cualquier ministerio. Editar/borrar:
    // staff, o el propio líder que lo creó (created_by_uid == su uid).
    match /events/{docId} {
      allow read: if isMiembro();
      allow create: if isStaff() || (isMinistryLeader() && request.resource.data.created_by_uid == request.auth.uid);
      allow update, delete: if isStaff() || (isMinistryLeader() && resource.data.created_by_uid == request.auth.uid);
    }
    // Inscripción a un evento normal: cada quien inscribe/cancela la suya.
    match /eventRegistrations/{docId} {
      allow read: if isMiembro();
      allow create: if isMiembro() && request.resource.data.member_id == myRoleDoc().member_id;
      allow delete: if isMiembro() && (resource.data.member_id == myRoleDoc().member_id || isStaff());
      // Solo el equipo cambia el método de pago de una inscripción.
      allow update: if isStaff();
    }
    // Turno de una cadena de oración/ayuno: mismo esquema que las inscripciones.
    match /eventChainSignups/{docId} {
      allow read: if isMiembro();
      allow create: if isMiembro() && request.resource.data.member_id == myRoleDoc().member_id;
      allow delete: if isMiembro() && (resource.data.member_id == myRoleDoc().member_id || isStaff());
      allow update: if false;
    }

    // ---------- Servicios (cultos) ----------
    // Antes caía en el catch-all abierto (cualquier isMiembro() podía
    // escribir) — se cierra a staff o a quien tenga "Gestionar servicios"
    // activado en la matriz de permisos.
    match /services/{docId} {
      allow read: if isMiembro() && resource.data.church_id == myChurchId();
      allow create: if isMiembro() && request.resource.data.church_id == myChurchId()
        && (isStaff() || hasDynamicPermission('manage_services'));
      allow update, delete: if isMiembro() && resource.data.church_id == myChurchId()
        && (isStaff() || hasDynamicPermission('manage_services'));
    }

    // ---------- Configuración (matriz de permisos, etc.) ----------
    // Mismo criterio que asignar roles: solo un administrador cambia esto.
    match /settings/{docId} {
      allow read: if isMiembro();
      allow write: if hasRole('admin');
    }

    // ---------- Notificaciones internas (campanita) ----------
    // Se crean SOLO desde el Admin SDK (Cloud Functions: inasistencias
    // seguidas y avisos de Mensajes) — un cliente nunca puede crear ni
    // borrar un aviso, solo marcarlo como leído agregando su propio uid a
    // read_by, sin tocar nada más del documento ni el historial de lectura
    // de otra persona. Un aviso llega por rol (target_roles, ej. "enviar a
    // todos") o por member_id (target_member_ids, para avisos de un
    // ministerio específico que no corresponde a un rol de cuenta) — se
    // acepta cualquiera de los dos caminos.
    // church_id: multi-iglesia — un aviso de Refugio no debe ser legible por
    // el admin/bienvenida de otra iglesia solo por compartir el mismo rol.
    // Los avisos de hoy (inasistencias, Mensajes) son todos de Refugio, así
    // que el default 'refugio' preserva el comportamiento actual.
    function esDestinatarioDeNotificacion(data) {
      return data.get('church_id', 'refugio') == myChurchId() && (
        data.target_roles.hasAny([myRoleDoc().role])
        || (myRoleDoc().member_id != null && data.get('target_member_ids', []).hasAny([myRoleDoc().member_id]))
      );
    }
    match /notifications/{docId} {
      allow read: if isMiembro() && esDestinatarioDeNotificacion(resource.data);
      allow update: if isMiembro() && esDestinatarioDeNotificacion(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
        && request.resource.data.read_by.hasAll(resource.data.read_by)
        && request.resource.data.read_by.hasAny([request.auth.uid]);
      allow create, delete: if false;
    }

    // ---------- Chat privado 1 a 1 entre miembros ----------
    // Solo los dos participantes pueden leer o escribir en su conversación;
    // nadie puede cambiar quiénes participan una vez creada. Los mensajes
    // viven en una subcolección para no reescribir todo el hilo cada vez.
    match /conversations/{conversationId} {
      allow read: if isMiembro() && request.auth.uid in resource.data.participants;
      allow create: if isMiembro() && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isMiembro() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMiembro()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isMiembro()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.sender_uid == request.auth.uid;
        allow update: if false;
        allow delete: if isMiembro() && resource.data.sender_uid == request.auth.uid;
      }
    }

    // ---------- Multi-iglesia: perfil de cada iglesia ----------
    // Lectura pública (a propósito): hace falta mostrar nombre/logo antes de
    // iniciar sesión (login, /registro/:slug). La creación va SOLO por la
    // función createChurch (Admin SDK, valida slug único y arma el resto de
    // la iglesia de forma atómica) — un cliente nunca crea esto directo.
    match /churches/{churchId} {
      allow read: if true;
      allow create: if false;
      allow update: if isMiembro() && myChurchId() == churchId && hasRole('admin');
      allow delete: if false;
    }

    // ---------- Multi-iglesia: índice correo → (usuario, iglesia) ----------
    // Documento mínimo, uno por correo, que permite al login resolver a qué
    // iglesia pertenece una cuenta SIN tener que sincronizar el directorio
    // completo de usuarios de todas las iglesias al navegador (ver
    // resolveChurchIdForLogin en mockData.js). Cada quien solo puede
    // leer/escribir el que corresponde a su PROPIO correo autenticado.
    match /userLookup/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow create, update: if isSignedIn() && request.auth.token.email == email
        && request.resource.data.user_id is string && request.resource.data.church_id is string;
      allow delete: if false;
      allow list: if false;
    }

    // ---------- Calendario de actividades ----------
    // Mismo criterio que Eventos: cualquier líder de ministerio (o el
    // equipo) puede agregar una actividad; editar/borrar solo staff o quien
    // la creó.
    match /activities/{docId} {
      allow read: if isMiembro();
      allow create: if isStaff() || (isMinistryLeader() && request.resource.data.created_by_uid == request.auth.uid);
      allow update, delete: if isStaff() || (isMinistryLeader() && resource.data.created_by_uid == request.auth.uid);
    }

    // ---------- Resto de colecciones ----------
    // memberProfiles, services, foro, anuncios, etc.: cualquier miembro
    // aprobado (no cualquier cuenta de Google autenticada).
    match /{collection}/{docId} {
      allow read, write: if isMiembro()
        && !(collection in ['offerings', 'tithes', 'userRoles', 'users', 'members', 'attendances', 'groupNotices', 'generalMessages', 'radioMessages', 'bibleHighlights', 'bibleComments', 'buenaTierraClasses', 'buenaTierraSettings', 'groupSettings', 'events', 'eventRegistrations', 'eventChainSignups', 'ministryOfferings', 'activities', 'services', 'settings', 'notifications', 'conversations', 'churches', 'userLookup', 'refugios', 'refugioEnrollments']);
    }
  }
}
