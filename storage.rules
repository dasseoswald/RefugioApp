rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fondos (foto o video) de los anuncios que se proyectan en la
    // presentación en vivo. Cualquier usuario autenticado puede gestionarlos
    // (coincide con el modelo de permisos del resto de la app, donde la
    // restricción a admin/controlador se hace en la interfaz, no aquí).
    match /announcements/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Imagen de los eventos permanentes (CET, Bibliatón). Quién puede
    // cambiarla lo decide firestore.rules (solo admin puede guardar la URL en
    // el evento); aquí solo se limita tipo y tamaño.
    match /eventPosters/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Logo de cada iglesia (multi-iglesia). Lectura pública: se muestra en
    // el login/registro antes de que nadie inicie sesión. Escritura para
    // cualquier usuario autenticado, mismo criterio que "announcements" —
    // la restricción real (solo puede subir el logo de SU propia iglesia)
    // se hace en la interfaz, no aquí.
    match /churches/{churchId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
